{
  "manifest_version": 3,
  "name": "Resolute: Video Quality Control",
  "version": "1.1.0",
  "description": "Pick video quality from a button inside the YouTube player. Set a default for all videos, for each channel, or for one video.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Resolute: Video Quality Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "resolute-video-quality@ghost-deku",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
