---
import { AMO, CHROME_ZIP } from '../data/links';
---
<section class="hero" aria-labelledby="hero-h">
  <p class="tg-cc"><span class="cc" aria-hidden="true">CC</span><span class="lines"><span><i aria-hidden="true">[ </i>Quality and speed, inside the player<i aria-hidden="true"> ]</i></span><span><i aria-hidden="true">[ </i>It remembers every video and every channel<i aria-hidden="true"> ]</i></span></span></p>
  <h1 id="hero-h" class="bigh" data-res>YouTube on <em>your terms.</em></h1>
  <p class="sub">Resolute adds a quality and speed button inside the video player, and remembers your choice for each video and each channel.</p>
  <div class="cta">
    <a class="btn primary" href={AMO} target="_blank" rel="noopener">Add to Firefox</a>
    <a class="btn tonal" href={CHROME_ZIP} download="resolute-chrome.zip">Chrome: download ZIP</a>
  </div>
  <div class="stage" id="stage" data-mount="hero">
    <div class="pwrap dk"><div class="glowbox"><div class="frame" style="min-height:200px"><div class="poster" aria-hidden="true" style="background:linear-gradient(135deg,#ffd23f,#1fb5c9 45%,#5b1e8c 75%,#ff7a2f)"></div></div></div></div>
  </div>
</section>
