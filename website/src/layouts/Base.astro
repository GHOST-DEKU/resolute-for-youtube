---
import '@fontsource-variable/google-sans-flex';
import '../styles/site.css';
import '../styles/extra.css';
import '../styles/extra2.css';
import '../styles/extra3.css';
import '../styles/autoplay.css';
import '../styles/player.css';
import '../styles/resume.css';
import '../styles/world.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(base + '/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/png" href={base + '/favicon.png'} />
  <meta name="color-scheme" content="light dark" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href={base + '/fonts/gsf-wdth.woff2'} />
  <style set:html={`@font-face{font-family:"GSFW";src:url(${base}/fonts/gsf-wdth.woff2) format("woff2");font-weight:1 1000;font-stretch:25% 151%;font-display:swap}`}></style>
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body class="site" data-theme="light" data-glow="1">
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('resolute-theme'); } catch (e) {}
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.body.dataset.theme = t;
    })();
  </script>
  <slot />
</body>
</html>
